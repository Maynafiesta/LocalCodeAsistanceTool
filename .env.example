# Generate actual keys using codeassist-client, then copy its server.env to .env.
CODEASSIST_TOKENS='{}'
BIND_ADDRESS=127.0.0.1
MAX_CONCURRENT_REQUESTS=3
MAX_QUEUED_REQUESTS=15
MONITOR_USERS='["developer"]'
MODEL_CONTEXT_LENGTH=4096
COMPLETION_CONTEXT_LENGTH=8192
COMPLETION_MAX_TOKENS=256
# For a pilot without retrieval: CONTEXT_INDEX_PATH=/context/unindexed.sqlite
CHAT_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
COMPLETION_MODEL=qwen2.5-coder:1.5b-base
